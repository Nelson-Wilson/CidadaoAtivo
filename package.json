{
  "name": "cidadao-ativo",
  "version": "2.0.0",
  "description": "Cidadão Ativo — plataforma de reporte urbano (Node.js + Express + EJS), pronta para Vercel + Supabase, com IA Gemini.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node database/seed.js",
    "preflight": "node scripts/preflight.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --watch",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.unit.js",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.integration.js --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.unit.js --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/cli": "^4.3.5",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
