<%- include('../layouts/header') %>

<header class="mb-6">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-blue-700 dark:border-blue-800 dark:bg-blue-950/60 dark:text-blue-300">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
        Administração
    </span>
    <h1 class="ca-page-title mt-2">Contas de pessoal</h1>
    <p class="ca-muted mt-1">Técnicos, gestores municipais e administradores. Os cidadãos registam-se sozinhos.</p>
</header>
<%- include('_tabs', { tab: tab }) %>

<div class="ca-card ca-card-pad mb-6">
    <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Nova conta de pessoal</h2>
    <form method="POST" action="<%= url('/admin/utilizadores') %>" class="mt-4 grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
            <label for="u-name" class="ca-label">Nome</label>
            <input id="u-name" name="name" required value="<%= old.name || '' %>" class="ca-input">
        </div>
        <div>
            <label for="u-email" class="ca-label">Email</label>
            <input id="u-email" type="email" name="email" required value="<%= old.email || '' %>" class="ca-input">
        </div>
        <div>
            <label for="u-pass" class="ca-label">Password <span class="font-normal text-slate-400">(mín. 8)</span></label>
            <input id="u-pass" type="password" name="password" minlength="8" required autocomplete="new-password" class="ca-input">
        </div>
        <div>
            <label for="u-role" class="ca-label">Papel</label>
            <select id="u-role" name="role" class="ca-input">
                <% [['tecnico','Técnico'],['municipio','Gestor municipal'],['admin','Administrador']].forEach(function(r) { %>
                    <option value="<%= r[0] %>" <%= old.role === r[0] ? 'selected' : '' %>><%= r[1] %></option>
                <% }) %>
            </select>
        </div>
        <div>
            <label for="u-mun" class="ca-label">Município</label>
            <select id="u-mun" name="municipality_id" class="ca-input">
                <option value="">—</option>
                <% municipalities.forEach(function(m) { %><option value="<%= m.id %>" <%= Number(old.municipality_id) === Number(m.id) ? 'selected' : '' %>><%= m.name %></option><% }) %>
            </select>
        </div>
        <div>
            <label for="u-dep" class="ca-label">Departamento <span class="font-normal text-slate-400">(técnicos)</span></label>
            <select id="u-dep" name="department_id" class="ca-input">
                <option value="">—</option>
                <% departments.forEach(function(d) { %><option value="<%= d.id %>" <%= Number(old.department_id) === Number(d.id) ? 'selected' : '' %>><%= d.municipality_name %> · <%= d.name %></option><% }) %>
            </select>
        </div>
        <button type="submit" class="ca-btn-primary sm:col-span-2 lg:col-span-3 lg:justify-self-start">Criar conta</button>
    </form>
</div>

<div class="ca-card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="ca-table">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">Email</th>
                    <th scope="col">Papel</th>
                    <th scope="col">Município</th>
                    <th scope="col">Departamento</th>
                    <th scope="col">Criada em</th>
                </tr>
            </thead>
            <tbody>
            <% users.forEach(function(u) { %>
                <tr>
                    <td class="font-semibold text-slate-800 dark:text-slate-100"><%= u.name %></td>
                    <td class="text-xs text-slate-500 dark:text-slate-400"><%= u.email %></td>
                    <td><span class="ca-badge border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-800 dark:bg-blue-950/50 dark:text-blue-300"><%= roleLabel(u.role) %></span></td>
                    <td class="text-xs text-slate-500 dark:text-slate-400"><%= u.municipality_name || '—' %></td>
                    <td class="text-xs text-slate-500 dark:text-slate-400"><%= u.department_name || '—' %></td>
                    <td class="text-xs text-slate-400 dark:text-slate-500"><%= formatDate(u.created_at) %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layouts/footer') %>
