<%- include('../layouts/header') %>

<div class="max-w-md mx-auto py-10">
    <div class="bg-white border border-jacaranda-100 rounded-3xl p-8 sm:p-10 shadow-soft">
        <div class="text-center mb-8">
            <div class="w-14 h-14 rounded-2xl bg-jacaranda-100 text-jacaranda-700 flex items-center justify-center text-2xl mx-auto mb-3 shadow-xs">
                🇲🇿
            </div>
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-ink mb-1.5">Criar conta gratuita</h1>
            <p class="text-xs sm:text-sm text-ink/50">Junta-te a milhares de cidadãos ativos para melhorar a cidade.</p>
        </div>

        <form method="POST" action="<%= url('/registar') %>" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
                <label for="name" class="block text-xs font-semibold text-ink/70 mb-1.5">Nome Completo</label>
                <input type="text" name="nome" id="name" value="<%= old.nome || old.name || '' %>" required autocomplete="name"
                       placeholder="O teu nome e apelido"
                       class="w-full rounded-xl border border-jacaranda-100 px-4 py-2.5 text-sm text-ink/90 focus:outline-none focus:ring-2 focus:ring-jacaranda-300 placeholder:text-ink/30 transition">
            </div>

            <div>
                <label for="email" class="block text-xs font-semibold text-ink/70 mb-1.5">Email</label>
                <input type="email" name="email" id="email" value="<%= old.email || '' %>" required autocomplete="email"
                       placeholder="exemplo@dominio.co.mz"
                       class="w-full rounded-xl border border-jacaranda-100 px-4 py-2.5 text-sm text-ink/90 focus:outline-none focus:ring-2 focus:ring-jacaranda-300 placeholder:text-ink/30 transition">
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold text-ink/70 mb-1.5">Palavra-passe (mínimo 8 caracteres)</label>
                <input type="password" name="senha" id="password" required minlength="8" autocomplete="new-password"
                       placeholder="••••••••"
                       class="w-full rounded-xl border border-jacaranda-100 px-4 py-2.5 text-sm text-ink/90 focus:outline-none focus:ring-2 focus:ring-jacaranda-300 placeholder:text-ink/30 transition">
            </div>

            <div>
                <label for="password_confirmation" class="block text-xs font-semibold text-ink/70 mb-1.5">Confirmar Palavra-passe</label>
                <input type="password" name="confirmacao_senha" id="password_confirmation" required minlength="8" autocomplete="new-password"
                       placeholder="••••••••"
                       class="w-full rounded-xl border border-jacaranda-100 px-4 py-2.5 text-sm text-ink/90 focus:outline-none focus:ring-2 focus:ring-jacaranda-300 placeholder:text-ink/30 transition">
            </div>

            <button type="submit"
                    class="w-full rounded-full bg-jacaranda-600 hover:bg-jacaranda-700 text-white py-3 text-sm font-semibold shadow-md hover:shadow-lg transition mt-2">
                Concluir Registo
            </button>
        </form>

        <div class="mt-8 pt-6 border-t border-jacaranda-50 text-center">
            <p class="text-xs text-ink/60">
                Já tens conta registada?
                <a href="<%= url('/login') %>" class="text-jacaranda-600 font-semibold hover:underline ml-1">Entra aqui</a>.
            </p>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
