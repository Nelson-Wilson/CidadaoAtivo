<%- include('../layouts/header') %>

<nav class="mb-5 flex items-center gap-2 text-xs font-medium text-slate-400 dark:text-slate-500" aria-label="Navegação estrutural">
    <a href="<%= url('/') %>" class="inline-flex items-center gap-1 transition hover:text-blue-600 dark:hover:text-blue-400">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
        Voltar ao mapa
    </a>
    <span aria-hidden="true">/</span>
    <span class="text-slate-700 dark:text-slate-200">Ocorrência #<%= report.id %></span>
</nav>

<header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-bold text-slate-400 dark:text-slate-500">#<%= report.id %></span>
            <span class="ca-badge <%= statusClasses(report.status) %>"><%= statusLabel(report.status) %></span>
            <span class="ca-badge <%= priorityClasses(report.priority) %>"><%= priorityLabel(report.priority) %></span>
        </div>
        <h1 class="ca-page-title mt-2"><%= report.category_name %></h1>
        <p class="ca-muted mt-1">Reportada a <%= formatDateTime(report.created_at) %> · Bairro <%= report.neighborhood || 'Maputo' %> · <%= report.department_name || 'a aguardar triagem' %></p>
    </div>
    <a href="https://www.openstreetmap.org/?mlat=<%= report.latitude %>&mlon=<%= report.longitude %>#map=18"
       target="_blank" rel="noopener noreferrer" class="ca-btn-secondary self-start">Abrir no mapa ↗</a>
</header>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
    <div class="space-y-6 lg:col-span-3">
        <section class="ca-card ca-card-pad">
            <% if (report.photo_path) { %>
                <img src="<%= url(report.photo_path) %>" alt="Fotografia da ocorrência <%= report.category_name %>" loading="lazy"
                     class="mb-4 max-h-96 w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700">
            <% } %>
            <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300"><%- nl2br(report.description) %></p>

            <div class="mt-5 flex flex-wrap items-center gap-3">
                <span class="text-sm text-slate-600 dark:text-slate-300">👍 <strong id="votes-count"><%= report.votes_count %></strong> confirmações</span>
                <% if (canVote && !isAuthor) { %>
                    <form method="POST" action="<%= url('/ocorrencias/' + report.id + '/votar') %>" class="inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="<%= hasVoted ? 'ca-btn-primary' : 'ca-btn-secondary' %>">
                            <%= hasVoted ? '✓ Também me afeta (retirar)' : 'Também me afeta' %>
                        </button>
                    </form>
                <% } else if (!usuarioAtual) { %>
                    <a href="<%= url('/login') %>" class="ca-link text-sm">Entra para apoiar esta ocorrência</a>
                <% } else if (isAuthor) { %>
                    <span class="text-xs text-slate-400 dark:text-slate-500">Foste tu que reportaste esta ocorrência.</span>
                <% } %>
            </div>
            <% if (typeof rating !== 'undefined' && rating) { %>
                <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">Avaliação do cidadão: <span class="text-amber-400"><%= '★'.repeat(rating.score) %></span><span class="text-slate-300 dark:text-slate-700"><%= '★'.repeat(5 - rating.score) %></span></p>
            <% } %>
        </section>

        <section id="comentarios" class="ca-card ca-card-pad">
            <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Comentários (<%= comments.length %>)</h2>

            <% if (!comments.length) { %>
                <p class="mt-3 rounded-xl border border-dashed border-slate-200 p-4 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">Ainda não há comentários.</p>
            <% } %>
            <div class="mb-6 mt-4 space-y-3">
                <% comments.forEach(function(c) { %>
                    <div class="rounded-xl border p-3.5 <%= c.is_official ? 'border-blue-200 bg-blue-50/70 dark:border-blue-900 dark:bg-blue-950/30' : 'border-slate-100 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-900/60' %>">
                        <div class="mb-1 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                            <span class="font-semibold text-slate-700 dark:text-slate-200">
                                <%= c.author_name %>
                                <% if (c.is_official) { %><span class="ml-1 rounded-full bg-blue-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Oficial</span><% } %>
                            </span>
                            <span><%= formatDateTime(c.created_at) %></span>
                        </div>
                        <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300"><%- nl2br(c.content) %></p>
                    </div>
                <% }) %>
            </div>

            <% if (canComment) { %>
                <form method="POST" action="<%= url('/ocorrencias/' + report.id + '/comentar') %>" class="space-y-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label for="content" class="ca-label">Adicionar comentário</label>
                    <textarea id="content" name="content" rows="3" maxlength="<%= maxComment %>" required
                              class="ca-input" placeholder="Partilha informação útil sobre esta ocorrência..."><%= old.content || '' %></textarea>
                    <button type="submit" class="ca-btn-primary">Publicar</button>
                </form>
            <% } else if (!usuarioAtual) { %>
                <p class="text-xs text-slate-500 dark:text-slate-400"><a href="<%= url('/login') %>" class="ca-link">Entra</a> para comentar.</p>
            <% } %>
        </section>
    </div>

    <div class="lg:col-span-2">
        <section class="ca-card ca-card-pad">
            <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Linha do tempo</h2>
            <ol class="relative mt-4 space-y-4 pl-5 before:absolute before:bottom-2 before:left-[0.3rem] before:top-2 before:w-px before:bg-slate-200 dark:before:bg-slate-700">
                <% history.forEach(function(entry) { %>
                    <li class="relative">
                        <span class="absolute -left-[1.05rem] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-blue-500 shadow-sm dark:border-slate-900"></span>
                        <strong class="block text-xs font-bold text-slate-800 dark:text-slate-100"><%= statusLabel(entry.new_status) %></strong>
                        <span class="text-[10px] text-slate-400 dark:text-slate-500"><%= formatDateTime(entry.created_at) %></span>
                    </li>
                <% }) %>
            </ol>
        </section>
    </div>
</div>

<%- include('../layouts/footer') %>
