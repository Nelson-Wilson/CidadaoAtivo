# ==============================================================================
# CIDADÃO ATIVO — variáveis de ambiente (Vercel + Supabase)
# Em produção defina-as em Vercel > Project Settings > Environment Variables.
# Localmente copie este ficheiro para .env.  NUNCA faça commit do .env.
# ==============================================================================

# --- Sessão (OBRIGATÓRIO em produção; a app recusa arrancar sem isto) ---------
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Base de dados: Supabase > Project Settings > Database > Connection string --
# Na Vercel use o "Transaction pooler" (porta 6543), não a ligação direta.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Fotografias: Supabase Storage (bucket público "ocorrencias") --------------
# Project Settings > API: URL do projeto e chave "service_role" (SECRETA: só no servidor!)
SUPABASE_URL=https://wsosnxtefniabkcrcqht.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_rgbaWPnOLI_9dSn4brKeWw_5AzkyZkQ
SUPABASE_STORAGE_BUCKET=cidadao-ativo
# Em desenvolvimento sem Supabase pode usar a pasta local public/uploads:
# STORAGE_DRIVER=local
STORAGE_DRIVER=supabase


# --- IA: Google Gemini (opcional). Sem chave, o chatbot usa respostas de contingência
# e tudo o resto continua a funcionar com regras locais. Chave grátis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
# Usado automaticamente se o principal falhar (404/429/503 ou timeout):
AI_MODEL_FALLBACK=gemini-3.5-flash-lite
# MINIMAL | LOW | MEDIUM | HIGH (vazio desativa o parâmetro)
AI_THINKING_LEVEL=LOW
# AI_TIMEOUT_MS=20000
# Desligar funcionalidades individuais com "false":
# AI_FEATURE_CLASSIFICATION=true
# AI_FEATURE_DUPLICATES=true
# AI_FEATURE_SUMMARY=true
# AI_FEATURE_PRIORITY=true
# AI_FEATURE_CHATBOT=true
# AI_FEATURE_SMART_DASHBOARD=true
# AI_FEATURE_PHOTO_ANALYSIS=true
# AI_FEATURE_EXECUTIVE_REPORT=true
AI_DUPLICATE_RADIUS_KM=0.3

# TRUST_PROXY=1                     (por defeito 1 em produção/Vercel)

# --- Outros ---------------------------------------------------------------------
# APP_URL=https://o-seu-dominio.com   (opcional; só usado em mensagens)
# APP_TIMEZONE=Africa/Maputo
# UPLOAD_MAX_BYTES=4194304            (a Vercel limita pedidos a 4,5 MB)

# --- Primeiro administrador (usado por: npm run seed) ---------------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=        (mínimo 12 caracteres)
# SEED_DEMO=false             (não criar denúncias/contas de demonstração)
