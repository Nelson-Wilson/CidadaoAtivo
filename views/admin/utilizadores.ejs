<%- include('../layouts/header') %>

<div class="mb-6">
    <h1 class="font-display text-3xl font-bold text-ink">Administração</h1>
    <p class="text-sm text-ink/50">Contas de pessoal. Os cidadãos registam-se sozinhos.</p>
</div>
<%- include('_tabs', { tab: tab }) %>

<div class="bg-white border border-jacaranda-100 rounded-3xl p-6 shadow-soft mb-8">
    <h2 class="font-display text-lg font-semibold text-ink mb-4">Nova conta de pessoal</h2>
    <form method="POST" action="<%= url('/admin/utilizadores') %>" class="grid sm:grid-cols-3 gap-4 items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
            <label for="u-name" class="text-xs font-semibold text-ink/60 block mb-1">Nome</label>
            <input id="u-name" name="name" required value="<%= old.name || '' %>" class="w-full rounded-xl border border-jacaranda-100 px-3 py-2 text-sm">
        </div>
        <div>
            <label for="u-email" class="text-xs font-semibold text-ink/60 block mb-1">Email</label>
            <input id="u-email" type="email" name="email" required value="<%= old.email || '' %>" class="w-full rounded-xl border border-jacaranda-100 px-3 py-2 text-sm">
        </div>
        <div>
            <label for="u-pass" class="text-xs font-semibold text-ink/60 block mb-1">Password (mín. 8)</label>
            <input id="u-pass" type="password" name="password" minlength="8" required autocomplete="new-password" class="w-full rounded-xl border border-jacaranda-100 px-3 py-2 text-sm">
        </div>
        <div>
            <label for="u-role" class="text-xs font-semibold text-ink/60 block mb-1">Papel</label>
            <select id="u-role" name="role" class="w-full rounded-xl border border-jacaranda-100 px-3 py-2 text-sm">
                <% [['tecnico','Técnico'],['municipio','Gestor municipal'],['admin','Administrador']].forEach(function(r) { %>
                    <option value="<%= r[0] %>" <%= old.role === r[0] ? 'selected' : '' %>><%= r[1] %></option>
                <% }) %>
            </select>
        </div>
        <div>
            <label for="u-mun" class="text-xs font-semibold text-ink/60 block mb-1">Município</label>
            <select id="u-mun" name="municipality_id" class="w-full rounded-xl border border-jacaranda-100 px-3 py-2 text-sm">
                <option value="">—</option>
                <% municipalities.forEach(function(m) { %><option value="<%= m.id %>" <%= Number(old.municipality_id) === Number(m.id) ? 'selected' : '' %>><%= m.name %></option><% }) %>
            </select>
        </div>
        <div>
            <label for="u-dep" class="text-xs font-semibold text-ink/60 block mb-1">Departamento (técnicos)</label>
            <select id="u-dep" name="department_id" class="w-full rounded-xl border border-jacaranda-100 px-3 py-2 text-sm">
                <option value="">—</option>
                <% departments.forEach(function(d) { %><option value="<%= d.id %>" <%= Number(old.department_id) === Number(d.id) ? 'selected' : '' %>><%= d.municipality_name %> · <%= d.name %></option><% }) %>
            </select>
        </div>
        <button type="submit" class="rounded-full bg-jacaranda-600 hover:bg-jacaranda-700 text-white px-6 py-2.5 text-sm font-semibold transition sm:col-span-3 sm:justify-self-start">Criar conta</button>
    </form>
</div>

<div class="bg-white border border-jacaranda-100 rounded-3xl p-6 shadow-soft overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead>
            <tr class="text-xs uppercase tracking-wider text-ink/40 border-b border-jacaranda-100">
                <th class="py-2 pr-3">Nome</th><th class="py-2 pr-3">Email</th><th class="py-2 pr-3">Papel</th><th class="py-2 pr-3">Município</th><th class="py-2 pr-3">Departamento</th><th class="py-2">Criada em</th>
            </tr>
        </thead>
        <tbody>
        <% users.forEach(function(u) { %>
            <tr class="border-b border-jacaranda-50">
                <td class="py-2 pr-3 font-medium"><%= u.name %></td>
                <td class="py-2 pr-3 text-ink/60"><%= u.email %></td>
                <td class="py-2 pr-3"><%= u.role %></td>
                <td class="py-2 pr-3 text-ink/60"><%= u.municipality_name || '—' %></td>
                <td class="py-2 pr-3 text-ink/60"><%= u.department_name || '—' %></td>
                <td class="py-2 text-ink/40"><%= formatarData(u.created_at, false) %></td>
            </tr>
        <% }) %>
        </tbody>
    </table>
</div>

<%- include('../layouts/footer') %>
