<%- include('../../layouts/header') %>

<div class="mb-6 flex items-center gap-2 text-sm text-ink/50">
    <a href="<%= url('/tecnico/tarefas') %>" class="hover:text-jacaranda-600 transition flex items-center gap-1">
        <span>←</span>
        <span>Voltar às minhas tarefas</span>
    </a>
</div>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-3">
            <span class="text-sm font-mono text-ink/40 font-bold">Tarefa #<%= report.id %></span>
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-ink"><%= report.category_name %></h1>
        </div>
        <p class="text-xs sm:text-sm text-ink/50 mt-1">Bairro <%= report.neighborhood || 'Maputo' %> · <%= formatarData(report.created_at) %></p>
    </div>
    <div class="flex items-center gap-2">
        <span class="text-xs font-semibold px-3 py-1 rounded-full border <%= statusClasses(report.status) %>">
            <%= statusLabel(report.status) %>
        </span>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Informação da Ocorrência e Localização -->
    <div class="space-y-6">
        <div class="bg-white border border-jacaranda-100 rounded-3xl p-6 shadow-soft">
            <h2 class="font-display text-lg font-semibold text-ink mb-3">Foto Enviada pelo Cidadão</h2>
            <% if (report.photo_path) { %>
                <img src="<%= url(report.photo_path) %>" class="w-full max-h-80 rounded-2xl border border-jacaranda-100 object-cover mb-4">
            <% } %>

            <% if (summary && summary !== report.description) { %>
                <div class="mb-4 rounded-2xl bg-jacaranda-50/80 border border-jacaranda-100 p-4 text-xs text-jacaranda-800 leading-relaxed">
                    <span class="font-bold flex items-center gap-1 mb-1">
                        <span>🤖</span>
                        <span>Resumo Rápido da IA:</span>
                    </span>
                    <%= summary %>
                </div>
            <% } %>

            <div class="bg-parchment rounded-2xl p-4 border border-jacaranda-50 mb-5">
                <p class="text-xs font-semibold text-ink/40 uppercase tracking-wider mb-1">Descrição Completa</p>
                <p class="text-sm text-ink/90 leading-relaxed"><%- nl2br(report.description) %></p>
            </div>

            <div class="flex items-center justify-between bg-white border border-jacaranda-100 rounded-2xl p-4">
                <div>
                    <span class="text-xs text-ink/50 block font-medium">Coordenadas GPS</span>
                    <strong class="text-xs font-mono text-ink/80"><%= report.latitude %>, <%= report.longitude %></strong>
                </div>
                <a href="https://www.google.com/maps/search/?api=1&query=<%= report.latitude %>,<%= report.longitude %>"
                   target="_blank"
                   class="rounded-full bg-jacaranda-50 hover:bg-jacaranda-100 text-jacaranda-700 px-4 py-2 text-xs font-semibold transition flex items-center gap-1.5">
                    <span>🧭</span>
                    <span>Navegar no Mapa ↗</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Ações do Técnico -->
    <div class="space-y-6">
        <% if (report.status === 'atribuida') { %>
            <div class="bg-white border border-jacaranda-100 rounded-3xl p-6 shadow-soft text-center sm:text-left">
                <span class="text-2xl mb-2 block">🚀</span>
                <h2 class="font-display text-lg font-semibold text-ink mb-1">Pronto para iniciar?</h2>
                <p class="text-xs text-ink/60 mb-5 leading-relaxed">
                    Ao clicares em iniciar execução, o cidadão é notificado de que a equipa técnica está a caminho ou iniciou a intervenção no local.
                </p>
                <form method="POST" action="<%= url('/tecnico/tarefas/' + report.id + '/iniciar') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="w-full rounded-full bg-jacaranda-600 hover:bg-jacaranda-700 text-white px-6 py-3 text-sm font-semibold shadow-md transition">
                        Iniciar Execução do Trabalho
                    </button>
                </form>
            </div>
        <% } %>

        <% if (report.status === 'em_execucao') { %>
            <div class="bg-white border border-jacaranda-100 rounded-3xl p-6 sm:p-7 shadow-soft">
                <span class="text-2xl mb-2 block">📸</span>
                <h2 class="font-display text-lg font-semibold text-ink mb-1">Comprovar Resolução</h2>
                <p class="text-xs text-ink/60 mb-5 leading-relaxed">
                    Fotografa o problema resolvido para arquivamento oficial e notificação do munícipe.
                </p>

                <form method="POST" action="<%= url('/tecnico/tarefas/' + report.id + '/resolver') %>"
                      enctype="multipart/form-data" class="space-y-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div>
                        <label class="block text-xs font-semibold text-ink/70 mb-1.5">Fotografia da Resolução <span class="text-laterite-500">*</span></label>
                        <input type="file" name="photo" id="photo" accept="image/*" capture="environment" required
                               class="w-full text-xs text-ink/70 file:mr-3 file:rounded-full file:border-0 file:bg-jacaranda-100 file:text-jacaranda-700 file:px-4 file:py-2 file:text-xs file:font-semibold hover:file:bg-jacaranda-200 cursor-pointer">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-ink/70 mb-1.5">Observações da Intervenção (Opcional)</label>
                        <textarea name="note" rows="2" placeholder="Ex.: Buraco tapado com asfalto frio; lâmpada LED substituída..."
                                  class="w-full rounded-xl border border-jacaranda-100 px-3.5 py-2 text-xs text-ink/90 focus:outline-none focus:ring-2 focus:ring-jacaranda-300"></textarea>
                    </div>

                    <button type="submit" class="w-full rounded-full bg-mangrove-600 hover:bg-mangrove-700 text-white py-3 text-sm font-semibold shadow-md transition">
                        Marcar como Resolvida ✓
                    </button>
                </form>
            </div>
        <% } %>

        <% if (report.status === 'resolvida' || report.status === 'fechada') { %>
            <div class="bg-mangrove-50/70 border border-mangrove-100 rounded-3xl p-6 text-center shadow-soft">
                <span class="text-3xl mb-2 block text-mangrove-600">🎉</span>
                <h2 class="font-display text-lg font-bold text-mangrove-800 mb-1">Ocorrência Concluída</h2>
                <p class="text-xs text-mangrove-700 leading-relaxed">
                    Esta denúncia já foi dada como resolvida e arquivada com sucesso pela equipa técnica.
                </p>
                <% if (report.resolution_photo) { %>
                    <img src="<%= url(report.resolution_photo) %>" alt="Fotografia da resolução"
                         class="mt-4 w-full max-h-64 rounded-2xl border border-mangrove-200 object-cover">
                <% } %>
                <% if (report.resolution_note) { %>
                    <p class="mt-3 text-xs text-mangrove-800 text-left rounded-2xl bg-white/70 border border-mangrove-100 p-3 leading-relaxed"><%- nl2br(report.resolution_note) %></p>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../../layouts/footer') %>
