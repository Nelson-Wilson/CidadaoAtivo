<%- include('../layouts/header') %>

<header class="mb-6">
    <span class="ca-eyebrow">Administração</span>
    <h1 class="ca-page-title mt-1">Categorias e SLA</h1>
    <p class="ca-muted mt-1">Categorias de ocorrências, departamento responsável e prazo padrão de resolução.</p>
</header>
<%- include('_tabs', { tab: tab }) %>

<section class="ca-card mb-6 overflow-x-auto">
    <table class="ca-table min-w-[44rem]">
        <thead>
            <tr><th>Categoria</th><th>Departamento</th><th>SLA (horas)</th><th>Denúncias</th><th class="text-right">Ações</th></tr>
        </thead>
        <tbody>
        <% categories.forEach(function(c) { %>
            <tr class="align-middle">
                <td>
                    <form method="POST" action="<%= url('/admin/categorias/' + c.id) %>" id="cat-<%= c.id %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    </form>
                    <label class="sr-only" for="cat-name-<%= c.id %>">Nome da categoria</label>
                    <input id="cat-name-<%= c.id %>" form="cat-<%= c.id %>" name="name" value="<%= c.name %>" required maxlength="80" class="ca-input">
                </td>
                <td>
                    <label class="sr-only" for="cat-dep-<%= c.id %>">Departamento</label>
                    <select id="cat-dep-<%= c.id %>" form="cat-<%= c.id %>" name="department_id" class="ca-input">
                        <option value="">— sem departamento —</option>
                        <% departments.forEach(function(d) { %>
                            <option value="<%= d.id %>" <%= Number(c.department_id) === Number(d.id) ? 'selected' : '' %>><%= d.municipality_name %> · <%= d.name %></option>
                        <% }) %>
                    </select>
                </td>
                <td>
                    <label class="sr-only" for="cat-sla-<%= c.id %>">SLA em horas</label>
                    <input id="cat-sla-<%= c.id %>" form="cat-<%= c.id %>" type="number" name="sla_hours" value="<%= c.sla_hours %>" min="1" max="2160" required class="ca-input w-24">
                </td>
                <td class="text-slate-500 dark:text-slate-400"><%= c.reports_count %></td>
                <td class="whitespace-nowrap text-right">
                    <button form="cat-<%= c.id %>" type="submit" class="ca-btn-primary px-3 py-1.5 text-xs">Guardar</button>
                    <% if (Number(c.reports_count) === 0) { %>
                        <form method="POST" action="<%= url('/admin/categorias/' + c.id + '/remover') %>" class="inline" data-confirm="Remover esta categoria?">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="ca-btn-secondary px-3 py-1.5 text-xs text-rose-600 dark:text-rose-400">Remover</button>
                        </form>
                    <% } %>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
</section>

<section class="ca-card ca-card-pad">
    <h2 class="font-display text-base font-bold text-slate-900 dark:text-white">Nova categoria</h2>
    <form method="POST" action="<%= url('/admin/categorias') %>" class="mt-4 grid items-end gap-4 sm:grid-cols-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
            <label for="n-name" class="ca-label">Nome</label>
            <input id="n-name" name="name" required maxlength="80" value="<%= old.name || '' %>" placeholder="Ex.: Sinalização danificada" class="ca-input">
        </div>
        <div>
            <label for="n-dep" class="ca-label">Departamento responsável</label>
            <select id="n-dep" name="department_id" class="ca-input">
                <option value="">— sem departamento —</option>
                <% departments.forEach(function(d) { %><option value="<%= d.id %>"><%= d.municipality_name %> · <%= d.name %></option><% }) %>
            </select>
        </div>
        <div>
            <label for="n-sla" class="ca-label">Prazo SLA (horas)</label>
            <input id="n-sla" type="number" name="sla_hours" min="1" max="2160" value="<%= old.sla_hours || 72 %>" required class="ca-input">
        </div>
        <button type="submit" class="ca-btn-primary">Criar categoria</button>
    </form>
</section>

<%- include('../layouts/footer') %>
