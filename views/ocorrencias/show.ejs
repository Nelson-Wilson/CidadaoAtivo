<%- include('../layouts/header') %>

<div class="mb-6 flex items-center gap-2 text-sm text-ink/50">
    <a href="<%= url('/') %>" class="hover:text-jacaranda-600 transition flex items-center gap-1">
        <span>←</span><span>Voltar ao mapa</span>
    </a>
</div>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-3 flex-wrap">
            <span class="text-sm font-mono text-ink/40 font-bold">#<%= report.id %></span>
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-ink"><%= report.category_name %></h1>
            <span class="text-xs font-semibold px-3 py-1 rounded-full border <%= prioridadeClasses(report.priority) %>"><%= prioridadeLabel(report.priority) %></span>
        </div>
        <p class="text-xs sm:text-sm text-ink/50 mt-1">Reportada em <%= formatarData(report.created_at) %> · bairro <%= report.neighborhood || 'Maputo' %> · <%= report.department_name || 'a aguardar triagem' %></p>
    </div>
    <span class="self-start sm:self-auto text-sm font-semibold px-4 py-1.5 rounded-full border <%= statusClasses(report.status) %> shadow-xs">
        <%= statusLabel(report.status) %>
    </span>
</div>

<% const podeVerNotas = isAuthor || Boolean(usuarioAtual && ['municipio', 'tecnico', 'admin'].includes(usuarioAtual.role)); %>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
    <div class="lg:col-span-3 space-y-6">
        <div class="bg-white border border-jacaranda-100 rounded-3xl p-6 shadow-soft">
            <% if (report.photo_path) { %>
                <img src="<%= url(report.photo_path) %>" alt="Fotografia da ocorrência"
                     class="w-full max-h-96 rounded-2xl border border-jacaranda-100 object-cover mb-4">
            <% } %>
            <p class="text-sm text-ink/90 leading-relaxed mb-5"><%- nl2br(report.description) %></p>

            <div class="flex flex-wrap items-center gap-3">
                <span class="text-sm text-ink/70">👍 <strong id="votes-count"><%= report.votes_count %></strong> confirmações</span>
                <% if (canVote && !isAuthor) { %>
                    <form method="POST" action="<%= url('/ocorrencias/' + report.id + '/votar') %>" class="inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit"
                                class="rounded-full px-5 py-2 text-sm font-semibold transition <%= hasVoted ? 'bg-jacaranda-600 text-white hover:bg-jacaranda-700' : 'border border-jacaranda-200 text-jacaranda-700 bg-white hover:bg-jacaranda-50' %>">
                            <%= hasVoted ? '✓ Também me afeta (retirar)' : 'Também me afeta' %>
                        </button>
                    </form>
                <% } else if (!usuarioAtual) { %>
                    <a href="<%= url('/login') %>" class="text-sm text-jacaranda-600 font-semibold hover:underline">Entra para apoiar esta ocorrência</a>
                <% } else if (isAuthor) { %>
                    <span class="text-xs text-ink/40">Foste tu que reportaste esta ocorrência.</span>
                <% } %>
                <a href="https://www.openstreetmap.org/?mlat=<%= report.latitude %>&mlon=<%= report.longitude %>#map=18"
                   target="_blank" rel="noopener" class="text-sm text-jacaranda-600 font-semibold hover:underline">Abrir mapa ↗</a>
            </div>
            <% if (typeof rating !== 'undefined' && rating) { %>
                <p class="mt-4 text-sm text-ink/60">Avaliação do cidadão: <span class="text-baobab-400"><%= '★'.repeat(rating.score) %></span><span class="text-ink/20"><%= '★'.repeat(5 - rating.score) %></span></p>
            <% } %>

            <% if (report.resolution_photo) { %>
                <div class="mt-5 rounded-2xl border border-mangrove-100 bg-mangrove-50/50 p-4">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-mangrove-700 mb-2">Resolução</h2>
                    <img src="<%= url(report.resolution_photo) %>" alt="Fotografia da resolução"
                         class="w-full max-h-72 rounded-xl border border-mangrove-100 object-cover">
                    <% if (podeVerNotas && report.resolution_note) { %>
                        <p class="mt-3 text-sm text-mangrove-800 leading-relaxed"><%- nl2br(report.resolution_note) %></p>
                    <% } %>
                </div>
            <% } %>
        </div>

        <div id="comentarios" class="bg-white border border-jacaranda-100 rounded-3xl p-6 shadow-soft">
            <h2 class="font-display text-lg font-semibold text-ink mb-4">Comentários (<%= comments.length %>)</h2>

            <% if (!comments.length) { %>
                <p class="text-xs text-ink/50 py-2">Ainda não há comentários.</p>
            <% } %>
            <div class="space-y-3 mb-6">
                <% comments.forEach(function(c) { %>
                    <div class="rounded-2xl p-3.5 border <%= c.is_official ? 'bg-jacaranda-50/70 border-jacaranda-200' : 'bg-parchment/60 border-jacaranda-50' %>">
                        <div class="flex items-center justify-between text-[11px] text-ink/50 mb-1">
                            <span class="font-semibold text-ink/70">
                                <%= c.author_name %>
                                <% if (c.is_official) { %><span class="ml-1 px-2 py-0.5 rounded-full bg-jacaranda-600 text-white text-[10px] uppercase tracking-wide">Oficial</span><% } %>
                            </span>
                            <span><%= formatarData(c.created_at) %></span>
                        </div>
                        <p class="text-sm text-ink/90 leading-relaxed"><%- nl2br(c.content) %></p>
                    </div>
                <% }) %>
            </div>

            <% if (canComment) { %>
                <form method="POST" action="<%= url('/ocorrencias/' + report.id + '/comentar') %>" class="space-y-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label for="content" class="text-xs font-semibold text-ink/60 block">Adicionar comentário</label>
                    <textarea id="content" name="content" rows="3" maxlength="<%= maxComment %>" required
                              class="w-full rounded-2xl border border-jacaranda-100 p-3 text-sm focus:outline-none focus:ring-2 focus:ring-jacaranda-400"
                              placeholder="Partilha informação útil sobre esta ocorrência..."><%= old.content || '' %></textarea>
                    <button type="submit" class="rounded-full bg-jacaranda-600 hover:bg-jacaranda-700 text-white px-6 py-2.5 text-sm font-semibold transition">Publicar</button>
                </form>
            <% } else if (!usuarioAtual) { %>
                <p class="text-xs text-ink/50"><a href="<%= url('/login') %>" class="text-jacaranda-600 font-semibold hover:underline">Entra</a> para comentar.</p>
            <% } %>
        </div>
    </div>

    <div class="lg:col-span-2">
        <div class="bg-white border border-jacaranda-100 rounded-3xl p-6 shadow-soft">
            <h2 class="font-display text-lg font-semibold text-ink mb-4">Linha do tempo</h2>
            <div class="relative pl-6 space-y-5 before:content-[''] before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-jacaranda-100">
                <% history.forEach(function(entry) { %>
                    <div class="relative">
                        <span class="absolute -left-[27px] top-1 w-3.5 h-3.5 rounded-full border-2 border-white bg-jacaranda-500 shadow-xs"></span>
                        <strong class="text-sm font-semibold text-ink block"><%= statusLabel(entry.new_status) %></strong>
                        <span class="text-[11px] text-ink/50"><%= formatarData(entry.created_at) %></span>
                        <% if (podeVerNotas && entry.note) { %>
                            <p class="mt-2 text-xs text-ink/70 rounded-lg bg-parchment/70 border border-jacaranda-50 p-2.5"><%- nl2br(entry.note) %></p>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
