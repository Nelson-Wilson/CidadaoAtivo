# ==============================================================================
# Cidadao Ativo - variaveis de ambiente (Vercel + Supabase + Gemini)
# Em producao defina-as em Vercel > Project Settings > Environment Variables.
# Localmente copie este ficheiro para .env. NUNCA faca commit do .env.
# ==============================================================================

# --- Sessao (OBRIGATORIO em producao; a app recusa arrancar sem isto) ---------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Aplicacao -----------------------------------------------------------------
# URL publica (usada em mensagens e cookies). Em producao deve ser https.
# APP_URL=https://o-seu-dominio.com
# APP_TIMEZONE=Africa/Maputo
# Numero de proxies a confiar (Vercel = 1, valor por omissao).
# TRUST_PROXY=1

# --- Base de dados: Supabase > Project Settings > Database > Connection string --
# Na Vercel use o "Transaction pooler" (porta 6543), nao a ligacao direta.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DB_POOL_MAX=3

# --- Fotografias: Supabase Storage (bucket publico) ----------------------------
# Project Settings > API: URL do projeto e chave "service_role" (SECRETA: so no servidor!)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ocorrencias
# Em desenvolvimento sem Supabase pode usar a pasta local public/uploads:
# STORAGE_DRIVER=local
# Limite do upload em bytes (a Vercel limita pedidos a 4,5 MB).
# UPLOAD_MAX_BYTES=4194304

# --- IA: Google Gemini (opcional) ----------------------------------------------
# Sem chave, o chatbot usa respostas de contingencia, a classificacao/prioridade
# usam regras locais e a analise de fotografias fica desativada.
# Obtenha a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AI_MODEL=gemini-3.6-flash
# AI_MODEL_FALLBACK=gemini-3.5-flash-lite
# AI_THINKING_LEVEL=LOW            (MINIMAL, LOW, MEDIUM ou HIGH)
# AI_TIMEOUT_MS=20000
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Desligar funcionalidades individuais com "false":
# AI_FEATURE_CLASSIFICATION=true
# AI_FEATURE_DUPLICATES=true
# AI_FEATURE_SUMMARY=true
# AI_FEATURE_PRIORITY=true
# AI_FEATURE_CHATBOT=true
# AI_FEATURE_SMART_DASHBOARD=true
# AI_FEATURE_PHOTO_ANALYSIS=true
# AI_FEATURE_EXECUTIVE_REPORT=true
# AI_DUPLICATE_RADIUS_KM=0.3

# --- Limites de pedidos (por IP) ------------------------------------------------
# AUTH_RATE_LIMIT_MAX=10           (15 minutos)
# COMMENT_RATE_LIMIT_MAX=20        (10 minutos)
# CHATBOT_RATE_LIMIT_MAX=15        (1 minuto)
# AI_RATE_LIMIT_MAX=30             (1 minuto)
# REPORT_RATE_LIMIT_MAX=5          (1 minuto)

# --- Primeiro administrador (usado por: npm run seed) ---------------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=             (minimo 12 caracteres)
# SEED_DEMO=false                  (nao criar denuncias/contas de demonstracao)
