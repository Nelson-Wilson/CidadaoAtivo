{
  "version": 2,
  "buildCommand": "npm run build:css",
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,public/**,database/**}",
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/", "destination": "/inicio", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
